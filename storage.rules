rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /chat-files/{chatId}/{msgId}/{filename} {
      function chatPath() {
        return /databases/(default)/documents/chats/$(chatId);
      }

      function chatDoc() {
        return firestore.get(chatPath());
      }

      function isMember() {
        return request.auth != null
          && firestore.exists(chatPath())
          && (request.auth.uid in chatDoc().data.members);
      }

      function canUpload() {
        return isMember()
          && (
            chatDoc().data.status == 'accepted' ||
            (chatDoc().data.status == 'pending' && chatDoc().data.requester == request.auth.uid)
          );
      }

      allow read: if isMember();

      allow write: if canUpload()
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^(image/(jpeg|png|webp)|application/pdf|text/plain|text/csv|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet)$');

      allow delete: if false;
    }
  }
}

