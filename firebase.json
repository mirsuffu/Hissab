{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Hisaab",
        "supportEmail": "mirsuffu@gmail.com"
      }
    }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "archive/**",
      "firestore.rules",
      "firestore.indexes.json",
      "package.json",
      "README.md",
      "**/*.md",
      "**/*.exe",
      "**/*.apk",
      "**/*.aab",
      "**/*.zip",
      "**/*.cer",
      "android/**",
      "android-build/**",
      "!.well-known/**",
      ".env*"
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
